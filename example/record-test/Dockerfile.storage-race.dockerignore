# Deny by default; the storage-race build only receives Go sources and required embeds.
**

!go.mod
!go.sum
!/*.go

!pb/
!pb/**/
!pb/*.go
!pb/**/*.go

!pkg/
!pkg/**/
!pkg/*.go
!pkg/**/*.go

!plugin/
!plugin/**/
!plugin/*.go
!plugin/**/*.go

!example/
!example/default/
!example/default/main.go

# Test sources and local/private material stay outside the build context.
*_test.go
**/*_test.go
**/testdata/
**/testdata/**
.git
.git/**
**/.git
**/.git/**
.claude
.claude/**
**/.claude
**/.claude/**
.worktrees
.worktrees/**
**/.worktrees
**/.worktrees/**
.superpowers
.superpowers/**
**/.superpowers
**/.superpowers/**
.remember
.remember/**
**/.remember
**/.remember/**
.env
.env.*
**/.env
**/.env.*
**/*.env
**/*.key
**/*.pem
**/*.crt
**/*.p12
**/*.pfx
**/*.db
**/*.db-shm
**/*.db-wal
**/*.db-journal
**/record/
**/record/**
**/recordings/
**/recordings/**
**/logs/
**/logs/**
**/reports/
**/reports/**
**/config*.yaml
**/config*.yml
**/config*.tmp
**/.storage-race/
**/.storage-race/**

# Explicit go:embed inputs needed by packages imported from example/default.
!plugin/debug/static/
!plugin/debug/static/**
!plugin/debug/pkg/internal/driver/html/
!plugin/debug/pkg/internal/driver/html/**
!plugin/debug/pkg/third_party/svgpan/svgpan.js
!plugin/hls/hls.js.zip
!plugin/preview/ui/
!plugin/preview/ui/**
!plugin/room/default.yaml
!plugin/test/default.yaml
!plugin/webrtc/default.yaml
!plugin/webrtc/web/
!plugin/webrtc/web/**
!plugin/webtransport/web/
!plugin/webtransport/web/**

# Final deny barrier: broad embed directories must never restore private/runtime files.
*_test.go
**/*_test.go
**/testdata/
**/testdata/**
.git
.git/**
**/.git
**/.git/**
.claude
.claude/**
**/.claude
**/.claude/**
.worktrees
.worktrees/**
**/.worktrees
**/.worktrees/**
.superpowers
.superpowers/**
**/.superpowers
**/.superpowers/**
.remember
.remember/**
**/.remember
**/.remember/**
.env
.env.*
**/.env
**/.env.*
**/*.env
**/*.key
**/*.pem
**/*.crt
**/*.cert
**/*.p12
**/*.pfx
**/*.db
**/*.sqlite
**/*.sqlite3
**/*.db-shm
**/*.db-wal
**/*.db-journal
**/*-shm
**/*-wal
**/*-journal
**/*.wal
**/*.journal
**/record/
**/record/**
**/recordings/
**/recordings/**
**/log/
**/log/**
**/logs/
**/logs/**
**/report/
**/report/**
**/reports/
**/reports/**
**/config*.yaml
**/config*.yml
**/config*.tmp
**/*config*.tmp
**/*.tmp.yaml
**/*.tmp.yml
**/.storage-race/
**/.storage-race/**

# The only post-barrier exceptions are tracked compile-time TLS embeds from pkg/config/tcp.go.
!pkg/config/local.monibuca.com_bundle.pem
!pkg/config/local.monibuca.com.key
